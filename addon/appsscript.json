{
  "timeZone": "Etc/UTC",
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/script.external_request",
    "https://www.googleapis.com/auth/drive.file"
  ],
  "dependencies": {
    "enabledAdvancedServices": [
      {
        "serviceId": "drive",
        "userSymbol": "Drive",
        "version": "v3"
      },
      {
        "serviceId": "docs",
        "userSymbol": "Docs",
        "version": "v1"
      }
    ]
  },
  "urlFetchWhitelist": [
    "https://www.googleapis.com/",
    "https://docs.googleapis.com/",
    "https://jsonresume.org/"
  ],
  "addOns": {
    "common": {
      "name": "JSON Resume",
      "logoUrl": "https://avatars.githubusercontent.com/u/7943272?s=200&v=4"
    },
    "flows": {
      "workflowElements": [
        {
          "id": "loadJsonResume",
          "state": "ACTIVE",
          "name": "Load JSON Resume",
          "description": "Loads your resume from your JSON Resume account (Connect JSON Resume), validates it against the jsonresume.org schema, and emits it as outputs for later steps.",
          "workflowAction": {
            "inputs": [],
            "outputs": [
              {
                "id": "resume",
                "description": "Resume (JSON)",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "resumeText",
                "description": "Resume (plain text)",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "name",
                "description": "Name",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "label",
                "description": "Headline",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "email",
                "description": "Email",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onConfigLoadJsonResume",
            "onExecuteFunction": "onExecuteLoadJsonResume"
          }
        },
        {
          "id": "renderResume",
          "state": "ACTIVE",
          "name": "Render JSON Resume to Doc",
          "description": "Renders a resume.json in the jsonresume.org standard - for example the output of Load JSON Resume, or an AI step's tailored version - into a Google Doc in your Drive, with PDF and DOCX download links. It can only see the files it creates.",
          "workflowAction": {
            "inputs": [
              {
                "id": "resume",
                "description": "Resume (JSON)",
                "cardinality": "SINGLE",
                "required": true,
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "title",
                "description": "Document title",
                "cardinality": "SINGLE",
                "required": false,
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "outputs": [
              {
                "id": "docId",
                "description": "Doc file ID",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "docUrl",
                "description": "Doc URL",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "pdfUrl",
                "description": "PDF download link",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "docxUrl",
                "description": "DOCX download link",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onConfigRenderResume",
            "onExecuteFunction": "onExecuteRenderResume"
          }
        }
      ]
    }
  }
}
